FNOS_URL=https://192.168.1.10:5667
FNOS_USERNAME=请替换为飞牛用户名
FNOS_PASSWORD=请替换为飞牛密码
# 可选：使用当前有效的 FnOS API token 代替用户名/密码。
# FNOS_TOKEN=

# 在线来源请求的最小间隔（毫秒，默认 2000）。
UPSTREAM_DELAY_MS=2000

# 可选：在线来源请求使用 HTTP/HTTPS 代理。请在实际 .env 中填写，勿提交代理凭据。
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,192.168.31.86,192.168.31.228,flymoo
