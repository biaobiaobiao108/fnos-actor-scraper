FNOS_URL=https://192.168.1.10:5667
FNOS_USERNAME=your-fnos-username
FNOS_PASSWORD=your-fnos-password
# Optional: use a current FnOS API token instead of username/password.
# FNOS_TOKEN=

# Host directory that contains the FnOS movie/TV library NFO files.
MEDIA_HOST_PATH=/vol1/你的影视库

# Minimum delay between external data-source requests (milliseconds; default 2000).
UPSTREAM_DELAY_MS=2000
